# ==============================================================================
# BizMetrics – Smart Business Intelligence: Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the actual .env file with secrets into version control.

# Application Environment (development | staging | production)
BIZMETRICS_ENV=production

# SQLite Database Filepaths (defaults to local workspace files)
BIZMETRICS_DB_PATH=bizmetrics.db
BIZMETRICS_AUTH_DB_PATH=bizmetrics_auth.db

# Default Active Multi-Tenant Branch & Administrative Credentials
DEFAULT_SHOP_ID=SHOP001
BIZMETRICS_OWNER_NAME="Shivansh G"
BIZMETRICS_OWNER_PASSWORD="YourStrongPasswordHere"

# AI Advisor Configuration (Groq Cloud LLM Integration)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Logging & Observability
LOG_LEVEL=INFO

# Application Host & Port (Used for deployment scripts)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

